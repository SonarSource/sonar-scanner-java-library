{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>SonarSource/renovate-config"
  ],
  "ignoreDeps": [
    "org.sonarsource.scanner.lib:it"
  ],
  "packageRules": [
    {
      "description": "Keep FastCSV on 3.x while scanner bootstrapping supports Java 11; FastCSV 4.x requires Java 17.",
      "matchPackageNames": [
        "de.siegmar:fastcsv"
      ],
      "allowedVersions": "<4.0.0"
    },
    {
      "description": "Keep SLF4J 1.x compatibility for Scanner for Maven with Maven < 4.",
      "matchPackageNames": [
        "org.slf4j:slf4j-api"
      ],
      "allowedVersions": "<2.0.0"
    },
    {
      "description": "Keep unit-test logging compatible with the library's SLF4J 1.x API.",
      "matchFileNames": [
        "lib/pom.xml",
        "download-cache/pom.xml"
      ],
      "matchPackageNames": [
        "ch.qos.logback:logback-classic"
      ],
      "allowedVersions": "<1.3.0"
    },
    {
      "description": "Keep integration-test Jetty dependencies on 10.x until ProxyServer's javax.servlet and Jetty APIs are migrated.",
      "matchFileNames": [
        "its/it-tests/pom.xml"
      ],
      "matchPackageNames": [
        "org.eclipse.jetty:*"
      ],
      "allowedVersions": "<11.0.0"
    }
  ]
}
